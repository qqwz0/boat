# Set to true on machines without the real motor board attached (dev laptops, CI).
HARDWARE_MOCK=true

# I2C: motor board control channel.
I2C_BUS=1
I2C_ADDRESS=16
# ^ 0x10 placeholder - TODO: confirm the real device address from the motor board's protocol docs.

# UART: motor board telemetry.
UART_PORT=/dev/serial0
UART_BAUDRATE=9600

# Failsafe: stop motors if no client heartbeat within this many seconds.
FAILSAFE_TIMEOUT_SEC=2.5

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Self-update
GITHUB_REPO_URL=https://github.com/<user>/<repo>.git
UPDATE_BRANCH=main
MAX_BACKUPS=5
BACKUP_DIR=backups

# SQLite log of commands, events, and update history.
DB_PATH=boat.db
