[Unit]
Description=Bait Boat Control Service
After=network.target

[Service]
Type=simple
# TODO: adjust User/WorkingDirectory/paths to match the actual deployment user and clone location.
User=pi
WorkingDirectory=/home/pi/Boat
EnvironmentFile=/home/pi/Boat/.env
ExecStart=/home/pi/Boat/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
